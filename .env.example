# Neon Postgres
# Use the pooled connection string for app runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Use the direct connection string for Prisma CLI and migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Cron protection
CRON_SECRET="replace-with-a-long-random-string"

# Arkesel
ARKESEL_API_KEY="replace-with-arkesel-api-key"
ARKESEL_SENDER_ID="StormGH"
ARKESEL_API_BASE_URL="https://sms.arkesel.com"
ARKESEL_WEBHOOK_SECRET="replace-with-a-long-random-string"

# App behavior
ALERT_COOLDOWN_HOURS="6"
OTP_EXPIRY_MINUTES="10"
OTP_PEPPER="replace-with-a-long-random-string"
NEXT_PUBLIC_APP_NAME="StormAlert GH"
NEXT_PUBLIC_ARKESEL_USSD_CODE="*928*01#"
