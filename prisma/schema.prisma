generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Subscriber {
  id                String    @id @default(cuid())
  phone             String    @unique
  regionCode        String    @map("region_code")
  forecastZoneCode  String?   @map("forecast_zone_code")
  forecastLat       Float?    @map("forecast_lat")
  forecastLon       Float?    @map("forecast_lon")
  locationAccuracyM Int?      @map("location_accuracy_m")
  active            Boolean   @default(false)
  createdAt         DateTime  @default(now()) @map("created_at")
  verifiedAt        DateTime? @map("verified_at")

  @@index([regionCode, active])
  @@index([forecastZoneCode, active])
  @@map("subscribers")
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, codeHash, used])
  @@index([expiresAt])
  @@map("otp_codes")
}

model AlertAreaUpdateRequest {
  id                String    @id @default(cuid())
  phone             String
  regionCode        String    @map("region_code")
  forecastZoneCode  String?   @map("forecast_zone_code")
  forecastLat       Float?    @map("forecast_lat")
  forecastLon       Float?    @map("forecast_lon")
  locationAccuracyM Int?      @map("location_accuracy_m")
  expiresAt         DateTime  @map("expires_at")
  consumedAt        DateTime? @map("consumed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([phone, consumedAt, expiresAt, createdAt])
  @@index([expiresAt])
  @@map("alert_area_update_requests")
}

model AlertLog {
  id              String   @id @default(cuid())
  regionCode      String   @map("region_code")
  triggeredAt     DateTime @default(now()) @map("triggered_at")
  triggerReason   String   @map("trigger_reason")
  recipientsCount Int      @map("recipients_count")
  weatherSnapshot Json     @map("weather_snapshot")

  @@index([regionCode, triggeredAt])
  @@map("alert_logs")
}

model RateLimitEvent {
  id         String   @id @default(cuid())
  action     String
  identifier String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([action, identifier, createdAt])
  @@index([createdAt])
  @@map("rate_limit_events")
}
